{
  "name": "pm4-web",
  "description": "PM4 web app (Next.js static export + shadcn)",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../api/openapi.json -o lib/api/schema.d.ts",
    "format": "prettier --write app components hooks lib \"*.ts\" \"*.mjs\"",
    "format:check": "prettier --check app components hooks lib \"*.ts\" \"*.mjs\""
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@date-fns/tz": "^1.5.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.8.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
