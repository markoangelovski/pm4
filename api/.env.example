# Every variable is documented in ../specs/02-architecture/environments.md.
# Dummy values only — nothing here is a real secret. Local values point at
# the docker-compose services (`docker compose up -d`).
#
# T-0001 validates only NODE_ENV, PORT, DATABASE_URL, REDIS_URL,
# CORS_ORIGINS and WEB_APP_URL (src/config/env.schema.ts). The rest are
# listed here for completeness and get added to the schema by the task that
# first uses them (auth → M1).

NODE_ENV=development
PORT=3001

# Postgres (docker-compose `postgres` service). Locally there is one
# connection string; in production DATABASE_URL is Neon's pooled URL and
# DATABASE_URL_DIRECT is the direct/unpooled one (migrations only).
DATABASE_URL=postgres://pm4:pm4@localhost:5432/pm4
DATABASE_URL_DIRECT=postgres://pm4:pm4@localhost:5432/pm4

# Redis (docker-compose `redis` service).
REDIS_URL=redis://localhost:6379

# Comma-separated, exact match, no credentials (arch-env, security.md).
CORS_ORIGINS=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Google OAuth (added to the schema in M1). Dummy placeholders.
GOOGLE_CLIENT_ID=dev-placeholder-client-id
GOOGLE_CLIENT_SECRET=dev-placeholder-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Auth/JWT (added to the schema in M1). Dummy placeholder, never a real secret.
JWT_ACCESS_SECRET=dev-only-placeholder-secret-please-change-32-bytes-min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
AUTH_ALLOWED_EMAILS=

# Trash retention (days).
TRASH_RETENTION_DAYS=31
